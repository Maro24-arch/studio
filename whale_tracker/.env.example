# Egypt World Cup Monitor – copy this file to .env and fill in your values

# Polymarket event slug (default works for 2026 World Cup)
POLYMARKET_EVENT_SLUG=world-cup-winner

# How often to check (seconds). 60 = every minute.
CHECK_INTERVAL_SEC=60

# ── ntfy.sh push notifications ─────────────────────────────────────────────
# Pick ANY unique topic name (no spaces). Subscribe to it at https://ntfy.sh
# or in the ntfy mobile app (iOS/Android) to receive push notifications.
NTFY_TOPIC=egypt-wc-tracker

# ── Optional: notify when change is ≥ this many percentage points ──────────
MIN_CHANGE_PCT=0.1

# ── Optional: email notifications (Gmail) ─────────────────────────────────
EMAIL_ENABLED=false
EMAIL_FROM=your-gmail@gmail.com
EMAIL_TO=marwansalem24@gmail.com
EMAIL_PASSWORD=your-app-password    # Gmail App Password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
